      "path": "/api/prompts/not-an-id",
      "expect": {
        "status": 400,
        "code": "bad_request"
      }
    },
    {
      "name": "an id with capitals",
      "method": "GET",
      "path": "/api/prompts/p-ABCDEFGHIJKL",
      "expect": {
        "status": 400,
        "code": "bad_request"
      }
    },
    {
      "name": "another person's private prompt is not there",
