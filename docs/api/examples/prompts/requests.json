{
  "name": "What a request must look like",
  "about": "Raw requests with the status and `code` they are answered with, by every server of this contract: the media type, the shape of the body, the permission, the revision, and which error wins. Before the cases, a reader makes the `seed` prompts for the person `sharer` (who holds `prompts.share`) with createPrompt, in order; `$idN` and `$revN` in a path or a body are the id and the revision of seed N. `as` is `sharer` (the default) or `plain`, another person with no `prompts.share`. A request with no `headers` member is sent with `content-type: application/json` when it has a body; `headers: {}` sends none. A `body` written as {\"$concat\": [piece, ...]} is the pieces joined, a piece being a string or {\"$repeat\": text, \"times\": n}. `expect.text` and `expect.revision` are checked on a 200 of a render or an update. No case changes a seed, so they run in any order. See docs/api/prompts-v1.md, Errors, and which wins.",
  "seed": [
    {
      "name": "review",
      "title": "Review",
      "body": "Review {{focus}}.",
      "variables": [
        {
          "id": "focus",
          "question": "Focus?",
          "type": "select",
          "options": [
            {
              "value": "security",
              "label": "Security"
            },
            {
              "value": "speed",
              "label": "Speed"
            }
          ]
        }
      ]
    },
    {
      "name": "hello",
      "title": "Hello",
      "body": "Hello."
    }
  ],
  "cases": [
    {
      "name": "the default listing",
      "method": "GET",
      "path": "/api/prompts",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "scope mine",
      "method": "GET",
      "path": "/api/prompts?scope=mine",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "scope shared",
      "method": "GET",
      "path": "/api/prompts?scope=shared",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "scope all",
      "method": "GET",
      "path": "/api/prompts?scope=all",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "a scope nobody has",
      "method": "GET",
      "path": "/api/prompts?scope=everything",
      "expect": {
        "status": 400,
        "code": "bad_scope"
      }
    },
    {
      "name": "an empty scope",
      "method": "GET",
      "path": "/api/prompts?scope=",
      "expect": {
        "status": 400,
        "code": "bad_scope"
      }
    },
    {
      "name": "a scope with a capital",
      "method": "GET",
      "path": "/api/prompts?scope=Mine",
      "expect": {
        "status": 400,
        "code": "bad_scope"
      }
    },
    {
      "name": "a cursor that is not an id",
      "method": "GET",
      "path": "/api/prompts?cursor=x",
      "expect": {
        "status": 400,
        "code": "bad_cursor"
      }
    },
    {
      "name": "a cursor with capitals",
      "method": "GET",
      "path": "/api/prompts?cursor=P-AAAAAAAAAAAA",
      "expect": {
        "status": 400,
        "code": "bad_cursor"
      }
    },
    {
      "name": "a cursor that is an id nobody has: a position, not a capability",
      "method": "GET",
      "path": "/api/prompts?cursor=p-aaaaaaaaaaaa",
      "expect": {
        "status": 200
      }
    },
    {
      "name": "the first seed",
      "method": "GET",
      "path": "/api/prompts/$id0",
      "expect": {
        "status": 200
