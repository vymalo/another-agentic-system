{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'msgId'}}{{jsonPath request.body '$.params.message.messageId' default='msg-local'}}{{/assign}}{{#assign 'ctxId'}}{{jsonPath request.body '$.params.message.contextId' default='ctx-local'}}{{/assign}}{{#assign 'taskId'}}task-{{msgId}}{{/assign}}{{#assign 'release'}}{{regexExtract (jsonPath request.body "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/release-channels/v1'].release" default='production') '[A-Za-z0-9._:-]+' default='production'}}{{/assign}}{{#assign 'revision'}}{{#if (eq release 'production')}}coder-r47{{/if}}{{#if (eq release 'staging')}}coder-r51{{/if}}{{#if (eq release 'latest')}}coder-r53{{/if}}{{#if (matches release '^coder-r(47|51|53)$')}}{{release}}{{/if}}{{/assign}}id: 1
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"task":{"id":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_SUBMITTED","timestamp":"{{now}}"},"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

id: 2
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_WORKING","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-working","role":"ROLE_AGENT","parts":[{"text":"Working on it."}]}},"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

id: 3
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"artifactUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","artifact":{"artifactId":"pull-request","name":"Pull request","description":"The pull request the mock agent pretends to have opened.","parts":[{"url":"https://github.com/example/sandbox/pull/1","mediaType":"text/html","filename":"pull-request"},{"text":"Pull request opened: https://github.com/example/sandbox/pull/1"}]},"lastChunk":true,"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

id: 4
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_COMPLETED","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-completed","role":"ROLE_AGENT","parts":[{"text":"Done. The pull request is ready for review."}]}},"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

