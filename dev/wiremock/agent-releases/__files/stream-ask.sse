{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'msgId'}}{{jsonPath request.body '$.params.message.messageId' default='msg-local'}}{{/assign}}{{#assign 'ctxId'}}{{jsonPath request.body '$.params.message.contextId' default=msgId}}{{/assign}}{{#assign 'taskId'}}task-{{msgId}}{{/assign}}{{#assign 'release'}}{{regexExtract (jsonPath request.body "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/release-channels/v1'].release" default='production') '[A-Za-z0-9._:-]+' default='production'}}{{/assign}}{{#assign 'revision'}}{{#if (eq release 'production')}}coder-r47{{/if}}{{#if (eq release 'staging')}}coder-r51{{/if}}{{#if (eq release 'latest')}}coder-r53{{/if}}{{#if (matches release '^coder-r(47|51|53)$')}}{{release}}{{/if}}{{/assign}}id: 1
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"task":{"id":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_SUBMITTED","timestamp":"{{now}}"},"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

