data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_WORKING","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-working","role":"ROLE_AGENT","parts":[{"text":"Working on it."}]}},"metadata":{"https://agents.vymalo.com/a2a/extensions/release-channels/v1":{"requested":"{{release}}","revision":"{{revision}}"}}}}}

