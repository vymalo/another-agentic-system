{
  "name": "SendStreamingMessage: a review request that names a commit of forty `a` (the sha of the coder's flawed push) -> working, a `verdict` with findings, completed",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.params.message.parts[0].text",
          "matches": "(?is).*\\bcommit a{40}\\b.*"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "stream-verdict-findings.sse"
  }
}
