{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'msgId'}}{{jsonPath request.body '$.params.message.messageId' default='msg-local'}}{{/assign}}{{#assign 'ctxId'}}{{jsonPath request.body '$.params.message.contextId' default=msgId}}{{/assign}}{{#assign 'taskId'}}task-{{msgId}}{{/assign}}{{#assign 'model'}}{{jsonPath request.body "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/model-pick/v1'].model" default='-'}}{{/assign}}{{#assign 'effort'}}{{jsonPath request.body "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/reasoning/v1'].effort" default='-'}}{{/assign}}id: 1
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"task":{"id":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_SUBMITTED","timestamp":"{{now}}"},"metadata":{"https://agents.vymalo.com/a2a/extensions/model-pick/v1":{"model":"{{model}}"},"https://agents.vymalo.com/a2a/extensions/reasoning/v1":{"effort":"{{effort}}"}}}}}

id: 2
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_WORKING","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-working","role":"ROLE_AGENT","parts":[{"text":"Working with {{model}} at {{effort}}."}]},"metadata":{"https://agents.vymalo.com/a2a/extensions/model-pick/v1":{"model":"{{model}}"},"https://agents.vymalo.com/a2a/extensions/reasoning/v1":{"effort":"{{effort}}"}}}}}}

