{
  "name": "SendStreamingMessage naming a model and a reasoning level under the activated extensions -> the task and its working update echo both, completed says which it worked with (model-pick/v1, reasoning/v1)",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "A2A-Extensions": {
        "contains": "https://agents.vymalo.com/a2a/extensions/model-pick/v1"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      },
      {
        "matchesJsonPath": "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/model-pick/v1'].model"
      },
      {
        "matchesJsonPath": "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/reasoning/v1'].effort"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "stream-pick.sse"
  }
}
