{
  "mappings": [
    {
      "name": "picked script: the model a message picked answers, and says which one it is (one)",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona-one"
            }
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-picked-one",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "{{jsonPath request.body '$.model'}}",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "I answered as {{jsonPath request.body '$.model'}}."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        },
        "transformers": [
          "response-template"
        ]
      }
    },
