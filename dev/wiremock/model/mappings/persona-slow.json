{
  "mappings": [
    {
      "name": "slow script: the message says [mock:slow], the model takes its time (20 s) and says it is still working",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role == 'user' && @.content contains '[mock:slow]')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "fixedDelayMilliseconds": 20000,
        "jsonBody": {
          "id": "chatcmpl-slow-script",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Still working on it, one moment."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    }
  ]
}
