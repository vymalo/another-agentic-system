{
  "mappings": [
    {
      "name": "browse script: the person's message asks for a picture too, ask_agent is offered, ask the browser to read the page and take a screenshot",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:browse]"
          },
          {
            "contains": "[mock:shot]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          },
          {
            "matchesJsonPath": "$.tools[?(@.function.name == 'ask_agent')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-browse-script-ask-shot",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "browse-ask-1",
                    "type": "function",
                    "function": {
                      "name": "ask_agent",
                      "arguments": "{\"agent\":\"browser\",\"message\":\"Open {{regexExtract request.body 'http://browser-site[A-Za-z0-9:./_-]*' default='http://browser-site:8080/'}}, read it and tell me what it says, with its URL. Take a screenshot of it too. [mock:shot]\"}"
                    }
                  }
                ]
              },
              "logprobs": null,
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
