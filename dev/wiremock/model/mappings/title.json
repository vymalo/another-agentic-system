{
  "mappings": [
    {
      "name": "title: the conversation asks for a failing model, so the thread keeps the first words of its first message",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-title"
            }
          },
          {
            "contains": "[mock:title-error]"
          }
        ]
      },
      "response": {
        "status": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": {
            "message": "the mock title model is down on request",
            "type": "server_error"
          }
        }
      }
    },
    {
