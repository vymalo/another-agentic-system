{
  "mappings": [
    {
      "name": "websearch script: the results are in, answer with the first source",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:websearch]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role == 'tool')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-websearch-script-answer",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "I searched the web with the tool you attached. The best source I found is {{regexExtract (jsonPath request.body '$.messages[-1].content') 'https://[A-Za-z0-9./_-]+'}}."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
    {
      "name": "websearch script: a web search is attached, search the web",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:websearch]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          },
          {
            "matchesJsonPath": "$.tools[?(@.function.name == 'websearch__web_search')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-websearch-script-call-1",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "websearch-call-1",
                    "type": "function",
                    "function": {
                      "name": "websearch__web_search",
                      "arguments": "{\"query\":\"football world cup 2014\"}"
                    }
                  }
                ]
              },
              "logprobs": null,
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
    {
      "name": "websearch script: no web search is attached, say so",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:websearch]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-websearch-script-none",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "No web search attached, so I cannot look that up. Attach one to this conversation and ask me again."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    }
  ]
}
