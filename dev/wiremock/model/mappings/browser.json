{
  "mappings": [
    {
      "name": "browser script 1: a new task that names a page, reset the browser first",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-browse"
            }
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role == 'user' && @.content contains 'http')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-browser-script-close",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-browse",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "browser-call-1",
                    "type": "function",
                    "function": {
                      "name": "browser__browser_close",
                      "arguments": "{}"
                    }
                  }
                ]
              },
              "logprobs": null,
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
    {
      "name": "browser script 2: the browser is reset, open the page the message names",
