                "tool_calls": [
                  {
                    "id": "browser-call-2",
                    "type": "function",
                    "function": {
                      "name": "browser__browser_navigate",
                      "arguments": "{\"url\":\"{{regexExtract request.body 'http://browser-site[A-Za-z0-9:./_-]*' default='http://browser-site:8080/'}}\"}"
