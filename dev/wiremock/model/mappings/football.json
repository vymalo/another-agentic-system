              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "fb-call-1",
                    "type": "function",
                    "function": {
                      "name": "ask_agent",
                      "arguments": "{\"agent\":\"mock-researcher\",\"message\":\"Find data on football in Europe from 2011 to 2019: the results, the champions and the goals of every season.\"}"
