    {
      "name": "football script: the person's message, ask_agent is offered, ask the researcher",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:football]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          },
          {
            "matchesJsonPath": "$.tools[?(@.function.name == 'ask_agent')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-football-script-call-1",
