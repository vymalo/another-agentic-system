          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "The planner broke the request into a plan. {{regexExtract request.body 'Goal: [A-Za-z0-9 ,.()_-]+' default='Goal: (missing)'}} {{regexExtract request.body 'Questions: [A-Za-z0-9 ,.?()_-]+' default='Questions: (missing)'}} I will not start before you answer and say go."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
