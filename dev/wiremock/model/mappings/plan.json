    },
    {
      "name": "plan script: the plan is back, show it and ask to confirm",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:plan]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role == 'tool' && @.tool_call_id == 'plan-call-1')]"
