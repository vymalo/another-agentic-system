{
  "mappings": [
    {
      "name": "plan session script: the person's request, subagent_start is offered, start the planner in a kept-open session",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:plan-session]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          },
          {
            "matchesJsonPath": "$.tools[?(@.function.name == 'subagent_start')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-plan-session-script-start",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "plan-session-start",
                    "type": "function",
                    "function": {
                      "name": "subagent_start",
                      "arguments": "{\"agent\":\"planner\",\"description\":\"Plan the team offsite\",\"prompt\":\"[mock:plan-session-r1] The person wants to organise a team offsite for twelve people and has given no dates and no budget. Make the plan.\",\"keep_open\":true}"
                    }
                  }
                ]
              },
              "logprobs": null,
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
