      "priority": 0,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-researcher"
