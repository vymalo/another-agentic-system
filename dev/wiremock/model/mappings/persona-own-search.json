{
  "mappings": [
    {
      "name": "own-search script: the results are in, answer with the first source",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:own-search]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role == 'tool')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-own-search-script-answer",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "I searched with the server you added. The best source I found is {{regexExtract (jsonPath request.body '$.messages[-1].content') 'https://[A-Za-z0-9./_-]+'}}."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
    {
      "name": "own-search script: a search server of the person's own is offered, search with it",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:own-search]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          },
          {
            "matchesJsonPath": "$.tools[?(@.function.name =~ /^u-[a-z0-9]+__web_search$/)]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-own-search-script-call-1",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": null,
                "tool_calls": [
                  {
                    "id": "own-search-call-1",
                    "type": "function",
                    "function": {
                      "name": "{{regexExtract (jsonPath request.body '$.tools[?(@.function.name =~ /^u-[a-z0-9]+__web_search$/)].function.name') 'u-[a-z0-9]+__web_search'}}",
                      "arguments": "{\"query\":\"football world cup 2014\"}"
                    }
                  }
                ]
              },
              "logprobs": null,
              "finish_reason": "tool_calls"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    },
    {
      "name": "own-search script: none of the person's own is offered, say so",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathPattern": "(/v1)?/chat/completions",
        "bodyPatterns": [
          {
            "matchesJsonPath": {
              "expression": "$.model",
              "equalTo": "mock-persona"
            }
          },
          {
            "contains": "[mock:own-search]"
          },
          {
            "matchesJsonPath": "$.messages[-1:][?(@.role != 'tool')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "id": "chatcmpl-own-search-script-none",
          "object": "chat.completion",
          "created": 1700000000,
          "model": "mock-persona",
          "system_fingerprint": "fp_mock",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "No search server of your own is offered to me, so I cannot look that up. Add one in your settings, attach it to this conversation and ask me again."
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 100,
            "completion_tokens": 20,
            "total_tokens": 120
          }
        }
      }
    }
  ]
}
