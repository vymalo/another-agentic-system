{
  "name": "SendStreamingMessage naming a locale under the activated extension -> the answer says which tag it read (locale/v1)",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "A2A-Extensions": {
        "contains": "https://agents.vymalo.com/a2a/extensions/locale/v1"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      },
      {
        "matchesJsonPath": "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/locale/v1'].locale"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "stream-locale.sse"
  }
}
