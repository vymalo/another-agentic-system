{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'msgId'}}{{jsonPath request.body '$.params.message.messageId' default='msg-local'}}{{/assign}}{{#assign 'ctxId'}}{{jsonPath request.body '$.params.message.contextId' default=msgId}}{{/assign}}{{#assign 'taskId'}}task-{{msgId}}{{/assign}}id: 1
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"task":{"id":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_SUBMITTED","timestamp":"{{now}}"}}}}

id: 2
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_WORKING","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-working","role":"ROLE_AGENT","parts":[{"text":"Working on it."}]}}}}}

id: 3
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"artifactUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","artifact":{"artifactId":"branch-{{msgId}}","name":"branch","parts":[{"data":{"repository":"https://github.com/example/sandbox.git","branch":"agent/verified","commit":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},"mediaType":"application/json"}]},"lastChunk":true}}}

id: 4
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctxId}}","status":{"state":"TASK_STATE_COMPLETED","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-completed","role":"ROLE_AGENT","parts":[{"text":"Pushed a fix for what the review found."}]}}}}}

