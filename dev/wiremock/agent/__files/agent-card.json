{
  "name": "mock-coder",
  "description": "WireMock stand-in for an A2A 1.0 coding agent (local development only).",
  "version": "0.0.0-mock",
  "supportedInterfaces": [
    {
      "url": "{{request.baseUrl}}/a2a",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": true,
    "extensions": [
      {
        "uri": "https://agents.vymalo.com/a2a/extensions/steps/v1",
        "description": "Reports its work as nested steps (the keyword steps shows them).",
        "required": false
      },
      {
        "uri": "https://agents.vymalo.com/a2a/extensions/text-stream/v1",
        "description": "Streams its replies as they are written (the keyword stream shows it).",
        "required": false
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
    {
      "id": "code",
      "name": "Code",
      "description": "Pretends to make a change and open a pull request.",
      "tags": [
        "mock",
        "code"
      ],
      "examples": [
        "add a health endpoint",
        "ask which branch",
        "fail please"
      ]
    }
  ],
  "securitySchemes": {
    "bearer": {
      "httpAuthSecurityScheme": {
        "scheme": "Bearer",
        "bearerFormat": "opaque"
      }
    }
  },
  "securityRequirements": [
    {
      "bearer": []
    }
  ]
}
