{
  "name": "SendMessage: keyword fail -> failed task",
  "priority": 6,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendMessage"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.params.message.parts[0].text",
          "matches": "(?is).*\\bfail\\b.*"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "send-failed.json"
  }
}
