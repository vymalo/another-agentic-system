data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"statusUpdate":{"taskId":"{{taskId}}","contextId":"{{ctx}}","status":{"state":"TASK_STATE_COMPLETED","timestamp":"{{now}}","message":{"messageId":"{{taskId}}-m","role":"ROLE_AGENT","parts":[{"text":"planner: round 1 done"}]}},"metadata":{"https://agents.vymalo.com/a2a/extensions/child-sessions/v1":{"session":"{{session}}","parentContextId":"{{parentCtx}}","agent":"planner","description":"Find the writers","keepOpen":{{keep}},"round":1,"by":"person","state":"{{#if (eq keep 'true')}}idle{{else}}closed{{/if}}","closing":false}}}}}

