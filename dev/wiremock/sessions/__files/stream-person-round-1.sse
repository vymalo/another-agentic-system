{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'taskId'}}{{jsonPath request.body '$.params.id'}}{{/assign}}{{#assign 'session'}}{{regexExtract taskId '^[^.]+\.keep-(true|false)\.[^.]+'}}{{/assign}}{{#assign 'parentCtx'}}{{regexExtract taskId '^[^.]+(?=\.keep-)'}}{{/assign}}{{#assign 'keep'}}{{regexExtract taskId '(?<=\.keep-)(true|false)'}}{{/assign}}{{#assign 'ctx'}}ctx-{{session}}{{/assign}}id: 1
