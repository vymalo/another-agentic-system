{{#assign 'rpcId'}}{{jsonPath request.body '$.id' default='0'}}{{/assign}}{{#assign 'ctx'}}{{jsonPath request.body '$.params.message.contextId'}}{{/assign}}{{#assign 'session'}}{{regexExtract ctx '(?<=^ctx-).+'}}{{/assign}}{{#assign 'parentCtx'}}{{regexExtract session '^[^.]+(?=\.keep-)'}}{{/assign}}{{#assign 'keep'}}{{regexExtract session '(?<=\.keep-)(true|false)'}}{{/assign}}{{#assign 'taskId'}}{{session}}.close{{/assign}}id: 1
data: {"jsonrpc":"2.0","id":"{{rpcId}}","result":{"task":{"id":"{{taskId}}","contextId":"{{ctx}}","status":{"state":"TASK_STATE_COMPLETED","timestamp":"{{now}}"},"metadata":{"https://agents.vymalo.com/a2a/extensions/child-sessions/v1":{"session":"{{session}}","parentContextId":"{{parentCtx}}","agent":"planner","description":"Find the writers","keepOpen":{{keep}},"round":3,"by":"person","state":"closed","closing":false}}}}}

