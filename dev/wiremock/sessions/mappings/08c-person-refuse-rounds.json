{
  "name": "SendStreamingMessage whose text starts [mock:refuse-rounds] -> UnsupportedOperation, adam's max_rounds words",
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "A2A-Extensions": {
        "contains": "https://agents.vymalo.com/a2a/extensions/child-sessions/v1"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.params.message.parts[0].text",
          "matches": "\\[mock:refuse-rounds\\].*"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "error-unsupported-rounds.json"
  }
}
