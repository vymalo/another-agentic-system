{
  "name": "SendStreamingMessage: the Task with its sessions ([]), working, the session opened (event), the helper's start step and call, the parent's call, completed; dribbled over 2 s (child-sessions/v1)",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "stream-parent.sse",
    "chunkedDribbleDelay": {
      "numberOfChunks": 8,
      "totalDuration": 2000
    }
  }
}
