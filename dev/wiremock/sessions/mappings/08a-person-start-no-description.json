{
  "name": "SendStreamingMessage with a start that has no description -> InvalidParams (adam's words), nothing started",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "A2A-Extensions": {
        "contains": "https://agents.vymalo.com/a2a/extensions/child-sessions/v1"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "SendStreamingMessage"
        }
      },
      {
        "matchesJsonPath": "$.params.message.metadata['https://agents.vymalo.com/a2a/extensions/child-sessions/v1'].start[?(!@.description)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "error-invalid-params-description.json"
  }
}
