{
  "name": "GetTask of the parent task without activation -> completed with its usage totals, and nothing of sessions",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "GetTask"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.params.id",
          "doesNotMatch": ".*-s1"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "get-task-parent-plain.json"
  }
}
