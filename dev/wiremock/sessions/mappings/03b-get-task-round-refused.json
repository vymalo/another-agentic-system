{
  "name": "GetTask of a round that does not activate child-sessions/v1 -> InvalidParams (a child context is refused without activation)",
  "priority": 4,
  "request": {
    "method": "POST",
    "urlPath": "/a2a",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.method",
          "equalTo": "GetTask"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.params.id",
          "matches": ".*-s1"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "error-invalid-params.json"
  }
}
