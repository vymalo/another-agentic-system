  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "tauri": "tauri",
    "build:web": "node scripts/build-web.mjs",
    "build": "node scripts/build-web.mjs && tauri build --config src-tauri/tauri.deployment.json",
    "build:debug": "node scripts/build-web.mjs && tauri build --debug --bundles deb --config src-tauri/tauri.deployment.json",
    "dev": "tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
