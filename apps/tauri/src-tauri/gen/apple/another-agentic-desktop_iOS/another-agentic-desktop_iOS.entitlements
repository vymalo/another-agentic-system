<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The OAuth callback is a Universal Link. The deployment serves the matching AASA document only after the
		Apple Team ID is configured (ADR 0047). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:agentic.servers.segning.pro</string>
	</array>
</dict>
</plist>
