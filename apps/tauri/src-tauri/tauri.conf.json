{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "another-agentic",
  "mainBinaryName": "another-agentic",
  "version": "0.1.0",
  "identifier": "com.vymalo.agentic",
  "build": {
    "frontendDist": "../../../web/out-tauri",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": {
      "script": "node scripts/build-web.mjs",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "another·agentic",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://agentic.servers.segning.pro https://auth.verif.fyi",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Chat with the agents of another-agentic-system",
    "longDescription": "The desktop app of another-agentic-system: the chat surface, signing in through the system browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0"
  }
}
