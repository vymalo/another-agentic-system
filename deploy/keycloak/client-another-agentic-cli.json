{
  "clientId": "another-agentic-cli",
  "name": "another-agentic-system CLI",
  "description": "A public client for scripts: the device authorization grant only, no password grant, no secret. Its tokens carry the chat's audience, e-mail and roles (deploy/keycloak/README.md).",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "standardFlowEnabled": false,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": true,
  "attributes": {
    "oauth2.device.authorization.grant.enabled": "true",
    "access.token.lifespan": "900"
  },
  "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
  "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
  "protocolMappers": [
    {
      "name": "audience another-agentic",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "another-agentic",
        "id.token.claim": "true",
        "access.token.claim": "true"
      }
    },
    {
      "name": "agentic_roles",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-client-role-mapper",
      "consentRequired": false,
      "config": {
        "usermodel.clientRoleMapping.clientId": "another-agentic",
        "claim.name": "agentic_roles",
        "jsonType.label": "String",
        "multivalued": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }
  ]
}
