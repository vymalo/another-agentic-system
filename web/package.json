{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../docs/api/chat-api.yaml -o src/lib/api/schema.d.ts",
    "dev": "pnpm gen:api && next dev -p 3000",
    "mock": "tsx mock/server.ts",
    "dev:mock": "pnpm gen:api && concurrently -k -n mock,web -c blue,green \"tsx watch mock/server.ts\" \"MOCK_API_ORIGIN=http://127.0.0.1:4010 next dev -p 3000\"",
    "build": "pnpm gen:api && next build",
    "build:e2e": "pnpm gen:api && MOCK_API_ORIGIN=http://127.0.0.1:4010 next build",
    "start": "next start -p 3000",
    "start:e2e": "MOCK_API_ORIGIN=http://127.0.0.1:4010 next start -p 3000",
    "build:system": "pnpm gen:api && API_ORIGIN=http://127.0.0.1:8080 next build",
    "check": "biome ci .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm gen:api && next typegen && tsc --noEmit",
    "test": "pnpm gen:api && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:system": "playwright test -c playwright.system.config.ts",
    "screens": "playwright test -c playwright.screens.config.ts",
    "catalog:lock": "tsx scripts/catalog-lock.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.0",
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-ag-ui": "0.0.62",
    "@assistant-ui/react-generative-ui": "0.0.21",
    "@assistant-ui/react-markdown": "0.14.17",
    "@cfworker/json-schema": "4.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.1",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "yaml": "^2.9.1"
  }
}
