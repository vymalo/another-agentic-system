# Settings for going live (dev/README.md, "Going live"). Copy this file to `.env` and edit it:
#
#   cp .env.example .env
#   docker compose -f compose.yaml -f compose.live.yaml --profile app up --build
#
# `.env` is read by `docker compose` from this directory and is listed in .gitignore: never commit it.
# Nothing here changes the offline stack: `docker compose --profile app up --build` ignores every variable
# below except the optional ports at the end, and runs on the dummy credentials of compose.yaml.
#
# Every value below is a PLACEHOLDER. The secrets are 32 bytes or more so that the orchestrator accepts them,
# but they are not secret: replace each with its own random value, for example
#
#   openssl rand -hex 32
#
# Validate the files without starting anything (this file stands in for a real `.env`):
#
#   docker compose -f compose.yaml -f compose.live.yaml --env-file .env.example config -q

# ---- the agents' model: any OpenAI-compatible endpoint (ADR 0005) -------------------------------------------
# The base URL includes /v1. A model on this machine (Ollama, LM Studio, vLLM) is reachable from the
# containers as http://host.docker.internal:<port>/v1. The coder, the chat and the researcher all use it.
MODEL_BASE_URL=https://api.openai.com/v1
# The key of that endpoint. May be empty for a local model that needs none.
MODEL_API_KEY=replace-with-the-api-key-of-the-model-endpoint
# The coder's model alias, and the alias OpenCode (the coder's editing agent) uses through the same endpoint.
MODEL=replace-with-a-model-name
OPENCODE_MODEL=replace-with-a-model-name
# Optional: another alias for the chat and for the researcher (a cheaper model is enough to chat). Unset, they use MODEL.
# CHAT_MODEL=replace-with-a-model-name
# RESEARCHER_MODEL=replace-with-a-model-name

# ---- GitHub: where the coder pushes and opens pull requests -----------------------------------------------
# A token that may push branches and open pull requests on the repositories you will name in a chat message
# (a fine-grained token with Contents and Pull requests: read and write). It is sent only to ALLOWED_REPO_HOSTS.
GITHUB_TOKEN=github_pat_replace_with_your_token
# GitHub Enterprise: https://<host>/api/v3
GITHUB_API_URL=https://api.github.com
# The hosts repositories may live on (comma-separated; `name` means any port).
ALLOWED_REPO_HOSTS=github.com

# ---- secrets between the parts of the stack ----------------------------------------------------------------
# The bearer token the orchestrator presents to the coder (and the coder accepts): 32 bytes or more.
CODER_A2A_TOKEN=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef
# The same for the chat and for the researcher, one token each.
CHAT_A2A_TOKEN=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef
RESEARCHER_A2A_TOKEN=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef
# The secret of the GitHub webhook, at least 32 bytes: the same value goes into the webhook's settings on GitHub.
# (Rotation: a comma-separated list, newest first; docs/api/webhooks.md.)
WEBHOOK_GITHUB_SECRETS=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef
# The key the thread-tools tokens are signed and verified with (thread-tools/v1): at least 32 bytes. The tokens
# open the per-thread MCP endpoint for the agent that was sent a message, and only inside the compose network
# (the edge does not route it), so the dummy of compose.yaml is enough to try the stack; set your own for
# anything else. Every orchestrator process gets the same value (workers mint, the control plane serves).
# (Rotation: THREAD_TOOLS_SECRET_PREVIOUS, docs/api/thread-tools-v1.md.)
THREAD_TOOLS_SECRET=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef
# The bearer token of an MCP client (Claude Code, opencode): at least 32 bytes. dev/mcp-tokens.yaml says
# whose jobs it starts.
MCP_TOKEN_DEV=replace-me-openssl-rand-hex-32-0123456789abcdef0123456789abcdef

# ---- GitHub webhooks through smee.io (optional, profile `smee`) --------------------------------------------
# GitHub cannot reach a laptop. smee.io relays its deliveries to a client that dials out. smee.io is a
# THIRD PARTY: it sees every payload (repository names, commit messages, the check results) and anyone who
# learns the channel URL can read them and post to it. Use a channel of your own (https://smee.io/new), keep the
# URL private, and leave this unset when you do not want any of that. The webhook signature is still
# checked by the orchestrator. Then add `--profile smee` to the command above, and in the repository's
# Settings > Webhooks set Payload URL to this URL, Content type to application/json, Secret to
# WEBHOOK_GITHUB_SECRETS and the events to "Check runs" (and "Workflow runs").
# SMEE_URL=https://smee.io/your-channel-id
# To start the profile without the flag, in this file:
# COMPOSE_PROFILES=app,smee

# ---- optional: the identity of the coder's commits ---------------------------------------------------------
# GIT_AUTHOR_NAME=adam-coder
# GIT_AUTHOR_EMAIL=adam-coder@users.noreply.github.com
# PR_DRAFT=false

# ---- optional: the coder's agent folder (its name, card and instructions, read once at startup) ------------
# A directory that holds instructions.md, mounted read-only at /etc/adam/agent. Default: ./dev/coder/agent, the
# copy vendored from adam-rs. It must be readable by uid 10001 (chmod -R a+rX). dev/README.md, "Change what the coder says".
# CODER_AGENT_DIR=./dev/coder/agent

# ---- optional: the folders of the chat and of the researcher (their name, card, instructions and tools) ------
# Each is a directory that holds instructions.md (and, for the researcher, mcp.json), mounted read-only at /etc/adam/agent and read
# once at startup. Defaults: ./dev/agents/chat/agent and ./dev/agents/researcher/agent. Readable by uid 10001 (chmod -R a+rX).
# NOTE the researcher still searches the MOCK web search live (canned results, whatever the question): this stack has no
# search provider credential. To search for real, point the "url" of its mcp.json at a search MCP server of your own.
# CHAT_AGENT_DIR=./dev/agents/chat/agent
# RESEARCHER_AGENT_DIR=./dev/agents/researcher/agent

# ---- optional: host ports (all are bound to 127.0.0.1), when the defaults clash with something running -----
# EDGE_PORT=8080
# POSTGRES_PORT=5432
# CODER_PORT=8090
# MOCK_AGENT_PORT=8081
# MOCK_AGENT_RELEASES_PORT=8082
# MOCK_VERIFIER_PORT=8083
# MOCK_OPENAI_PORT=8091
# MOCK_GITHUB_PORT=8092
# GIT_SERVER_PORT=8093
# ORCH_LOCAL_PORT=8095
# MOCK_MCP_SEARCH_PORT=8096
# MOCK_MODEL_PORT=8094
# CHAT_PORT=8097
# RESEARCHER_PORT=8098
